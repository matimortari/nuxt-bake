{
  "name": "nuxt-bake-monorepo",
  "type": "module",
  "private": true,
  "workspaces": ["web/", "package/"],
  "scripts": {
    "dev": "bun --cwd web dev",
    "build": "bun --cwd web build",
    "preview": "bun --cwd web preview",
    "start": "bun --cwd web start",
    "cli": "bun --cwd package start",
    "cli:dev": "bun --cwd package dev",
    "cli:build": "bun --cwd package build",
    "lint": "bun --cwd web lint && bun --cwd package lint",
    "lint:fix": "bun --cwd web lint:fix && bun --cwd package lint:fix",
    "typecheck": "bun --cwd web typecheck && bun --cwd package typecheck",
    "test": "bun --cwd package test",
    "coverage": "bun --cwd package coverage"
  },
  "devDependencies": {
    "@antfu/eslint-config": "10.0.0",
    "@types/node": "26.6.6",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "10.15.0",
    "eslint-plugin-format": "2.0.0",
    "typescript": "6.0.2"
  }
}
