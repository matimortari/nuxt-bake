{
  "name": "nuxt-bake",
  "type": "module",
  "version": "1.2.1",
  "description": "A CLI tool to quickly scaffold a Nuxt starter project",
  "author": "Matheus Mortari <matheus.felipe.19rt@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matimortari/nuxt-bake.git",
    "directory": "package"
  },
  "keywords": [
    "starter",
    "template",
    "nuxt",
    "nuxt4",
    "nuxtjs",
    "vue",
    "typescript",
    "tailwindcss",
    "prisma"
  ],
  "bin": {
    "nuxt-bake": "dist/src/index.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "engines": {
    "node": "^20.17.0 || ^22.13.0 || >=23.5.0"
  },
  "scripts": {
    "dev": "tsc --watch",
    "build": "tsc",
    "start": "node dist/src/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "clean": "rimraf dist my-nuxt-app",
    "test": "vitest run",
    "coverage": "vitest --coverage",
    "release:patch": "npm version patch --no-workspaces-update && npm publish --access public",
    "release:minor": "npm version minor --no-workspaces-update && npm publish --access public",
    "release:major": "npm version major --no-workspaces-update && npm publish --access public"
  },
  "dependencies": {
    "@inquirer/prompts": "8.7.5",
    "figures": "6.1.0",
    "yocto-spinner": "1.2.2"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "typescript": "6.0.2",
    "vitest": "5.1.0"
  }
}
